void DebugGenerateKeyDown(int key)
{
    CORE.Input.Keyboard.currentKeyState[key] = true;

    if (CORE.Input.Keyboard.previousKeyState[key] == false)
    {
        if (CORE.Input.Keyboard.keyPressedQueueCount < MAX_KEY_PRESSED_QUEUE)
        {
            // Add character to the queue
            CORE.Input.Keyboard.keyPressedQueue[CORE.Input.Keyboard.keyPressedQueueCount] = key;
            CORE.Input.Keyboard.keyPressedQueueCount++;
        }
    }
}

void DebugGenerateKeyUp(int key)
{
    // Input event
    CORE.Input.Keyboard.currentKeyState[key] = false;
}

void DebugGenerateMouseDown(int key)
{
    CORE.Input.Mouse.currentButtonState[key] = true;
}

void DebugGenerateMouseUp(int key)
{
    CORE.Input.Mouse.currentButtonState[key] = false;
}

void DebugGenerateMousePosition(float x, float y)
{
    CORE.Input.Mouse.currentPosition.x = x;
    CORE.Input.Mouse.currentPosition.y = y;
}

void DebugGenerateMouseWheelMove(float x, float y)
{
    CORE.Input.Mouse.currentWheelMove.x = x;
    CORE.Input.Mouse.currentWheelMove.y = y;
}

